{
  "entities": {
    "product": {
      "title": "Product",
      "description": "Pharmacy medicine and healthcare product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "genericName": { "type": "string" },
        "category": { "type": "string" },
        "schedule": { "type": "string" },
        "dosageForm": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "genericName", "category"]
    },
    "batch": {
      "title": "Batch",
      "description": "Batch inventory record with prices, expiry, and quantities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "batchNumber": { "type": "string" },
        "expiryDate": { "type": "string" },
        "mrp": { "type": "number" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "batchNumber", "expiryDate"]
    },
    "sale": {
      "title": "Sale",
      "description": "Point of sale transaction invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "totalAmount": { "type": "number" },
        "netProfit": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "invoiceNumber", "totalAmount"]
    },
    "setting": {
      "title": "StoreSettings",
      "description": "Store settings and business information",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "dlNumber": { "type": "string" },
        "dlNumber2": { "type": "string" },
        "gstin": { "type": "string" },
        "fssaiNumber": { "type": "string" },
        "invoiceTerms": { "type": "string" },
        "storeLogo": { "type": "string" },
        "stampLogo": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "supplier_order_list": {
      "title": "SupplierOrderList",
      "description": "Monthly medicine shortage list and supplier WhatsApp order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "monthYear": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierPhone": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "supplierName", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "product",
      "description": "Store medicine and product catalog"
    },
    "/batches/{batchId}": {
      "schema": "batch",
      "description": "Store batch records with pricing and expiry"
    },
    "/sales/{saleId}": {
      "schema": "sale",
      "description": "Store pharmacy sales and transactions"
    },
    "/settings/{settingId}": {
      "schema": "setting",
      "description": "Store settings and business information"
    },
    "/supplier_order_lists/{orderListId}": {
      "schema": "supplier_order_list",
      "description": "Store monthly supplier order lists"
    }
  }
}
